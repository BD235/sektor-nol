# ═══════════════════════════════════════════════════
# BACKEND (Express Server) — hanya tersedia di server
# ═══════════════════════════════════════════════════
# Di Cloud Run: set via Console → "Variables & Secrets" atau CLI:
#   gcloud run deploy --set-env-vars="GEMINI_API_KEY=AIza..."
GEMINI_API_KEY=your_gemini_api_key_here

# ═══════════════════════════════════════════════════
# FRONTEND (Vite) — HARUS berprefix VITE_
# ═══════════════════════════════════════════════════
# Variabel dengan prefix VITE_ akan di-inject ke bundle frontend
# saat build time. Akses via: import.meta.env.VITE_NAMA_VARIABEL
# Contoh:
# VITE_APP_TITLE=Sektor Nol

# ═══════════════════════════════════════════════════
# APP
# ═══════════════════════════════════════════════════
APP_URL=http://localhost:8080
PORT=8080
