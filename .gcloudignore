# Exclude dev/build files from Cloud Run source upload
# These will be rebuilt during Buildpacks build step

node_modules/
.git/
.gitignore
.env
.env.*
!.env.example

# Editor files
.vscode/
.idea/
*.sw?

# Build outputs (will be recreated by npm run build)
dist/
dist-server/
dist-ssr/

# Firebase dev files
.firebase/
firebase-debug.log*

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
